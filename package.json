{
  "name": "motion-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based AI motion graphics studio: code-driven deterministic animation, tiled high-resolution rendering and real client-side export.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run tests/core.test.ts",
    "test:watch": "vitest",
    "test:hirez": "vitest run tests/tiling.hires.test.ts --environment node",
    "test:e2e": "playwright test",
    "test:all": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=18.18"
  }
}
