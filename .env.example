# ---------------------------------------------------------------------------
# Motion Studio - environment variable examples (NO REAL SECRETS HERE)
#
# Any variable prefixed with VITE_ is INLINED INTO THE CLIENT BUNDLE at build
# time and is therefore visible to anybody who can load the app. Never put a
# private API key in a VITE_ variable for a publicly deployed build.
#
# For normal use you do not need any of these: enter API keys at runtime in
# Settings > AI provider. They are kept in memory (session) unless you
# explicitly choose to persist them in this browser's IndexedDB.
# ---------------------------------------------------------------------------

# Optional: default AI provider id used the first time the AI panel is opened.
# One of: none | gemini | openai-compatible | custom
VITE_DEFAULT_AI_PROVIDER=none

# Optional: default model id offered in the AI panel (does not contain secrets).
VITE_DEFAULT_AI_MODEL=gemini-2.0-flash

# Optional: base path the app is served from (GitHub Pages sub-path support).
# Leave empty for "/"; set to "/motion-code/" when deploying to
# https://<user>.github.io/motion-code/
VITE_BASE=/

# Optional: set to "true" to hide experimental/large-resolution export targets
# (8K/12K/16K) from the composition preset list on low-memory devices.
VITE_HIDE_EXTREME_RESOLUTIONS=false
